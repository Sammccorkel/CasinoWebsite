@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="user-info">
    <AuthorizeView>
        <Authorized>
            <div class="user-logged-in">
                <span class="username-display">Welcome, @context.User.Identity?.Name</span>
                <button class="btn btn-profile" @onclick="HandleProfile">Profile</button>
                <button class="btn btn-shop" @onclick="HandleShop">Shop</button>
                <button class="btn btn-logout" @onclick="HandleLogout">Logout</button>
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="user-not-logged-in">
                <button class="btn btn-secondary" @onclick="HandleLogin">Login</button>
                <button class="btn btn-primary" @onclick="HandleSignUp">Sign Up</button>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>

<style>
.user-info {
    display: flex;
    align-items: center;
}

.user-logged-in,
.user-not-logged-in {
    display: flex;
    align-items: center;
    gap: 1rem;
}

.username-display {
    color: #4ade80;
    font-weight: 600;
    margin-right: 0.5rem;
}

.btn {
    padding: 0.75rem 2rem;
    border: none;
    border-radius: 8px;
    font-family: 'Outfit', sans-serif;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.btn-primary {
    background: linear-gradient(135deg, #00ff41, #00d4ff);
    color: #0a0118;
    box-shadow: 0 0 20px rgba(0, 255, 65, 0.5);
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 30px rgba(0, 255, 65, 0.8);
}

.btn-secondary {
    background: rgba(255, 255, 255, 0.1);
    color: white;
    border: 2px solid rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(10px);
}

.btn-secondary:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.5);
}

.btn-profile {
    background: rgba(96, 165, 250, 0.2);
    color: #60a5fa;
    border: 2px solid rgba(96, 165, 250, 0.5);
}

.btn-profile:hover {
    background: rgba(96, 165, 250, 0.3);
    border-color: rgba(96, 165, 250, 0.8);
}

.btn-shop {
    background: rgba(255, 215, 0, 0.18);
    color: #ffd700;
    border: 2px solid rgba(255, 215, 0, 0.45);
}

.btn-shop:hover {
    background: rgba(255, 215, 0, 0.28);
    border-color: rgba(255, 215, 0, 0.8);
}

.btn-logout {
    background: rgba(239, 68, 68, 0.2);
    color: #ef4444;
    border: 2px solid rgba(239, 68, 68, 0.5);
}

.btn-logout:hover {
    background: rgba(239, 68, 68, 0.3);
    border-color: rgba(239, 68, 68, 0.8);
}
</style>

@code {
    private sealed class ApiResult
    {
        public bool Ok { get; set; }
        public int Status { get; set; }
        public string? Text { get; set; }
    }

    private void HandleLogin()
    {
        Navigation.NavigateTo("/login");
    }

    private void HandleSignUp()
    {
        Navigation.NavigateTo("/register");
    }

    private void HandleProfile()
    {
        Navigation.NavigateTo("/profile");
    }

    private void HandleShop()
    {
        Navigation.NavigateTo("/shop");
    }

    private async Task HandleLogout()
    {
        try
        {
            var result = await JS.InvokeAsync<ApiResult>("auth.logout");
            if (result.Ok)
            {
                Navigation.NavigateTo("/", forceLoad: true);
            }
            else
            {
                Console.WriteLine(!string.IsNullOrEmpty(result.Text)
                    ? $"Logout failed: {result.Text}"
                    : $"Logout failed with status {result.Status}.");
            }
        }
        catch (Exception)
        {
            // Error handled in UI
        }
    }
}
