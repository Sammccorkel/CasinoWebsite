@page "/register"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject HttpClient Http

<PageTitle>Sign Up - Chuds to Chads Casino</PageTitle>

<div class="auth-container">

    <!-- Animated background cards -->
    <div class="bg-elements">
        <div class="bg-card bg-card-1">♠</div>
        <div class="bg-card bg-card-2">♥</div>
        <div class="bg-card bg-card-3">♦</div>
        <div class="bg-card bg-card-4">♣</div>
    </div>

    <!-- Left panel: branding -->
    <div class="auth-panel auth-brand">
        <div class="brand-inner">
            <NavLink href="/" class="logo-link">
                <img src="/images/C2C-Logo-Transparent.png" alt="C2C Casino" class="logo-image" />
            </NavLink>
            <div class="brand-tagline">
                <h2>Begin Your <span class="highlight">Transformation.</span></h2>
                <p>Every Chad started as a Chud. Create your account and start climbing the ranks today.</p>
            </div>
            <div class="brand-chips">
                <div class="mini-chip chip-green">♠</div>
                <div class="mini-chip chip-gold">♥</div>
                <div class="mini-chip chip-red">♦</div>
            </div>
            <div class="perks">
                <div class="perk">
                    <div class="perk-icon">🎰</div>
                    <div>
                        <strong>$1,000 Free Chips</strong>
                        <p>On the house when you sign up</p>
                    </div>
                </div>
                <div class="perk">
                    <div class="perk-icon">🃏</div>
                    <div>
                        <strong>Instant Access</strong>
                        <p>Jump straight into Blackjack & Poker</p>
                    </div>
                </div>
                <div class="perk">
                    <div class="perk-icon">🏆</div>
                    <div>
                        <strong>Climb the Leaderboard</strong>
                        <p>Prove you're the biggest Chad</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right panel: register form -->
    <div class="auth-panel auth-form-panel">
        <div class="auth-form-inner">
            <div class="form-header">
                <h1 class="form-title">Create Account</h1>
                <p class="form-subtitle">Start your Chad journey</p>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-error">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    @errorMessage
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    @successMessage
                </div>
            }

            <div class="form-group">
                <label class="form-label">Username</label>
                <div class="input-wrapper">
                    <svg class="input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                    <input class="form-input @(usernameError ? "input-error" : "")"
                           type="text"
                           placeholder="Choose a username"
                           @bind="username"
                           @oninput="ValidateUsername" />
                </div>
                @if (usernameError)
                {
                    <span class="field-error">Username must be at least 3 characters.</span>
                }
            </div>

            <div class="form-group">
                <label class="form-label">Password</label>
                <div class="input-wrapper">
                    <svg class="input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                    </svg>
                    <input class="form-input @(passwordError ? "input-error" : "")"
                           type="@(showPassword ? "text" : "password")"
                           placeholder="Create a password"
                           @bind="password"
                           @oninput="ValidatePassword" />
                    <button class="toggle-password" @onclick="TogglePassword" type="button">
                        @if (showPassword)
                        {
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>
                            </svg>
                        }
                        else
                        {
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                            </svg>
                        }
                    </button>
                </div>
                @if (passwordError)
                {
                    <span class="field-error">Password must be at least 6 characters.</span>
                }
                <!-- Password strength bar -->
                @if (!string.IsNullOrEmpty(password))
                {
                    <div class="password-strength">
                        <div class="strength-bar">
                            <div class="strength-fill strength-@PasswordStrengthClass"></div>
                        </div>
                        <span class="strength-label @PasswordStrengthClass">@PasswordStrengthLabel</span>
                    </div>
                }
            </div>

            <div class="form-group">
                <label class="form-label">Confirm Password</label>
                <div class="input-wrapper">
                    <svg class="input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                    </svg>
                    <input class="form-input @(confirmPasswordError ? "input-error" : "")"
                           type="@(showPassword ? "text" : "password")"
                           placeholder="Confirm your password"
                           @bind="confirmPassword"
                           @oninput="ValidateConfirmPassword" />
                </div>
                @if (confirmPasswordError)
                {
                    <span class="field-error">Passwords do not match.</span>
                }
            </div>

            <button class="btn-submit @(isLoading ? "loading" : "")" @onclick="HandleRegister" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner"></span>
                    <span>Creating Account...</span>
                }
                else
                {
                    <span>Become a Chad</span>
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                    </svg>
                }
            </button>

            <div class="form-divider">
                <span>Already a Chad?</span>
            </div>

            <button class="btn-secondary-link" @onclick='() => Navigation.NavigateTo("/login")'>
                Sign In Instead
            </button>

            <p class="form-footer">
                All currency is virtual and for entertainment only. No real money involved.
            </p>
        </div>
    </div>
</div>

@code {
    private string username = string.Empty;
    private string password = string.Empty;
    private string confirmPassword = string.Empty;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isLoading = false;
    private bool showPassword = false;

    private bool usernameError = false;
    private bool passwordError = false;
    private bool confirmPasswordError = false;

    private void TogglePassword() => showPassword = !showPassword;

    // Password strength helpers
    private int PasswordStrength => password.Length switch
    {
        0 => 0,
        < 6 => 1,
        < 10 => 2,
        _ => password.Any(char.IsUpper) && password.Any(char.IsDigit) ? 4 : 3
    };

    private string PasswordStrengthClass => PasswordStrength switch
    {
        1 => "weak",
        2 => "fair",
        3 => "good",
        4 => "strong",
        _ => ""
    };

    private string PasswordStrengthLabel => PasswordStrength switch
    {
        1 => "Weak",
        2 => "Fair",
        3 => "Good",
        4 => "Strong",
        _ => ""
    };

    private void ValidateUsername(ChangeEventArgs e)
    {
        username = e.Value?.ToString() ?? string.Empty;
        usernameError = username.Length > 0 && username.Length < 3;
    }

    private void ValidatePassword(ChangeEventArgs e)
    {
        password = e.Value?.ToString() ?? string.Empty;
        passwordError = password.Length > 0 && password.Length < 6;
        if (!string.IsNullOrEmpty(confirmPassword))
            confirmPasswordError = password != confirmPassword;
    }

    private void ValidateConfirmPassword(ChangeEventArgs e)
    {
        confirmPassword = e.Value?.ToString() ?? string.Empty;
        confirmPasswordError = confirmPassword.Length > 0 && confirmPassword != password;
    }

    private bool IsFormValid()
    {
        return !string.IsNullOrWhiteSpace(username) &&
               username.Length >= 3 &&
               !string.IsNullOrWhiteSpace(password) &&
               password.Length >= 6 &&
               password == confirmPassword;
    }

    private async Task HandleRegister()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;

        // Run all validations
        usernameError = username.Length < 3;
        passwordError = password.Length < 6;
        confirmPasswordError = password != confirmPassword;

        if (!IsFormValid())
        {
            errorMessage = "Please fix the errors above before continuing.";
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            // Call the API endpoint with absolute URL
            var registerRequest = new { username, password };
            var url = $"{Navigation.BaseUri.TrimEnd('/')}/api/auth/register";
            var response = await Http.PostAsJsonAsync(url, registerRequest);
            
            if (response.IsSuccessStatusCode)
            {
                successMessage = "Account created successfully! Redirecting to login...";
                await Task.Delay(1500);
                Navigation.NavigateTo("/login");
            }
            else
            {
                // Try to get error details from response
                try
                {
                    var responseText = await response.Content.ReadAsStringAsync();
                    if (!string.IsNullOrEmpty(responseText))
                    {
                        errorMessage = $"Registration failed: {responseText}";
                    }
                    else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
                    {
                        errorMessage = "Username already taken or password doesn't meet requirements.";
                    }
                    else
                    {
                        errorMessage = $"Registration failed with status {response.StatusCode}.";
                    }
                }
                catch
                {
                    errorMessage = "Registration failed. Please try again.";
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
