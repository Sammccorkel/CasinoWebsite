@page "/Dashboard"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject MultiplayerService MultiplayerService
@inject LeaderboardService LeaderboardService
@inject IPlayerStatisticsService PlayerStatisticsService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Casino Dashboard - C2C Casino</PageTitle>

<div class="lobby-container">
    <div class="bg-grid"></div>
    <div class="bg-glow bg-glow-1"></div>
    <div class="bg-glow bg-glow-2"></div>

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert @(statusIsError ? "alert-danger" : "alert-success")" style="margin: 1rem auto; max-width: 1100px;">
            @statusMessage
        </div>
    }

    @if (dashboard is null)
    {
        <div class="profile-container">
            <div class="alert alert-loading">Loading dashboard...</div>
        </div>
    }
    else
    {
        <nav class="top-nav">
            <div class="nav-left">
                <a href="/" class="logo-link">
                    <img src="/images/C2C-Logo-Transparent.png" alt="C2C Casino" class="logo-nav" />
                </a>
            </div>

            <div class="nav-center">
                <div class="chip-balance">
                    <div class="balance-icon">🪙</div>
                    <div class="balance-info">
                        <span class="balance-label">Your Chips</span>
                        <span class="balance-amount">@FormatChips(dashboard.Chips)</span>
                    </div>
                </div>
            </div>

            <div class="nav-right" style="display: flex; align-items: center; gap: 0.75rem;">
                <div class="chip-balance" style="min-width: 220px;">
                    <div class="balance-info">
                        <span class="balance-label">Friend Code</span>
                        <span class="balance-amount">@dashboard.FriendCode</span>
                    </div>
                </div>

                <button class="nav-btn" @onclick="ToggleUserMenu">
                    <div class="user-avatar">@dashboard.UserName[0]</div>
                    <span>@dashboard.UserName</span>
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                </button>

                @if (showUserMenu)
                {
                    <div class="user-dropdown">
                        <div class="dropdown-item" @onclick="ViewProfile">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                            Profile
                        </div>
                        <div class="dropdown-item" @onclick="ViewStats">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                            </svg>
                            Statistics
                        </div>
                        <div class="dropdown-divider"></div>
                        <div class="dropdown-item logout" @onclick="HandleLogout">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                            </svg>
                            Logout
                        </div>
                    </div>
                }
            </div>
        </nav>

        <div class="lobby-content">
            <section class="welcome-section">
                <h1 class="welcome-title">Welcome Back, <span class="highlight">@dashboard.UserName</span></h1>
                <p class="welcome-subtitle">The tables are hot. Time to show them who's the real Chad.</p>
            </section>

            <section class="stats-grid">
                <div class="stat-card stat-card-chips">
                    <div class="stat-icon">💰</div>
                    <div class="stat-content">
                        <div class="stat-value">@FormatChips(dashboard.Chips)</div>
                        <div class="stat-label">Total Chips</div>
                    </div>
                    <div class="stat-trend @(dashboard.DailyEarnings >= 0 ? "positive" : "")">@SignedChips(dashboard.DailyEarnings) all-time</div>
                </div>

                <div class="stat-card stat-card-rank">
                    <div class="stat-icon">🏆</div>
                    <div class="stat-content">
                        <div class="stat-value">@dashboard.RankLabel</div>
                        <div class="stat-label">Rank</div>
                    </div>
                    <div class="stat-progress">
                        <div class="progress-bar">
                            <div class="progress-fill" style="width: @rankProgress%"></div>
                        </div>
                        <span class="progress-text">@rankProgress% to next rank</span>
                    </div>
                </div>

                <div class="stat-card stat-card-wins">
                    <div class="stat-icon">🎯</div>
                    <div class="stat-content">
                        <div class="stat-value">@winRate%</div>
                        <div class="stat-label">Win Rate</div>
                    </div>
                    <div class="stat-subtext">@DisplayTotalWins wins / @DisplayTotalGames games</div>
                </div>

                <div class="stat-card stat-card-streak">
                    <div class="stat-icon">🔥</div>
                    <div class="stat-content">
                        <div class="stat-value">@winStreak</div>
                        <div class="stat-label">Win Streak</div>
                    </div>
                    <div class="stat-subtext">Personal best: @bestStreak</div>
                </div>
            </section>

            <section class="games-section">
                <h2 class="section-header">
                    <span>Quick Play</span>
                    <a href="/games" class="view-all">View All Games →</a>
                </h2>

                <div class="games-grid">
                    <div class="game-card-lobby blackjack-card" @onclick='() => JoinGame("blackjack")'>
                        <div class="game-card-bg"></div>
                        <div class="game-card-content">
                            <div class="game-icon">🂡</div>
                            <h3 class="game-name">Blackjack</h3>
                            <p class="game-desc">Classic 21. Fast-paced action.</p>
                            <div class="game-stats-row">
                                <div class="game-stat">
                                    <span class="stat-dot online"></span>
                                    @blackjackOnline online
                                </div>
                                <div class="game-stat">
                                    @blackjackTables tables
                                </div>
                            </div>
                            <button class="btn-play">Play Now</button>
                        </div>
                    </div>

                    <div class="game-card-lobby poker-card" @onclick='() => JoinGame("poker")'>
                        <div class="game-card-bg"></div>
                        <div class="game-card-content">
                            <div class="game-icon">🃏</div>
                            <h3 class="game-name">Texas Hold'em</h3>
                            <p class="game-desc">Bluff, bet, and dominate.</p>
                            <div class="game-stats-row">
                                <div class="game-stat">
                                    <span class="stat-dot online"></span>
                                    @pokerOnline online
                                </div>
                                <div class="game-stat">
                                    @pokerTables tables
                                </div>
                            </div>
                            <button class="btn-play">Play Now</button>
                        </div>
                    </div>

                    <div class="game-card-lobby slots-card" @onclick='() => NavigationManager.NavigateTo("/slots/slots")'>
                        <div class="game-card-bg"></div>
                        <div class="game-card-content">
                            <div class="game-icon">🎰</div>
                            <h3 class="game-name">Slots</h3>
                            <p class="game-desc">Spin to win big.</p>
                            <div class="game-stats-row">
                                <div class="game-stat">Solo play</div>
                            </div>
                            <button class="btn-play">Play Now</button>
                        </div>
                    </div>

                    <div class="game-card-lobby roulette-card" @onclick='() => NavigationManager.NavigateTo("/roulette/roulette")'>
                        <div class="game-card-bg"></div>
                        <div class="game-card-content">
                            <div class="game-icon">🎡</div>
                            <h3 class="game-name">Roulette</h3>
                            <p class="game-desc">Bet on red, black, or your lucky number.</p>
                            <div class="game-stats-row">
                                <div class="game-stat">Solo play</div>
                            </div>
                            <button class="btn-play">Play Now</button>
                        </div>
                    </div>

                    <div class="game-card-lobby horses-card" @onclick='() => NavigationManager.NavigateTo("/HorseRacing/horserace")'>
                        <div class="game-card-bg"></div>
                        <div class="game-card-content">
                            <div class="game-icon">🐎</div>
                            <h3 class="game-name">Horse Racing</h3>
                            <p class="game-desc">Pick your horse and ride to glory.</p>
                            <div class="game-stats-row">
                                <div class="game-stat">Solo play</div>
                            </div>
                            <button class="btn-play">Play Now</button>
                        </div>
                    </div>
                </div>
            </section>

            <div class="two-column-section">
                <section class="live-tables">
                    <h2 class="section-header">
                        <span>🎲 Live Tables</span>
                    </h2>
                    <div class="tables-list">
                        @if (dashboard.JoinableRooms.Count == 0)
                        {
                            <div class="table-item">
                                <div class="table-left">
                                    <div class="table-info">
                                        <div class="table-name">No Live Tables Yet</div>
                                        <div class="table-meta">Create a table from the Blackjack or Poker lobby to make it show up here.</div>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            @foreach (var room in dashboard.JoinableRooms)
                            {
                                var isHost = room.HostUserId == currentUserId;
                                <div class="table-item @(room.IsClosing ? "table-full" : "")">
                                    <div class="table-left">
                                        <div class="table-icon">@(room.Game == GameType.Blackjack ? "🂡" : "🃏")</div>
                                        <div class="table-info">
                                            <div class="table-name">@room.Name</div>
                                            <div class="table-meta">
                                                @(room.Game == GameType.Blackjack ? "Blackjack" : "Poker") • @(room.Visibility == RoomVisibility.Private ? "Private" : "Public") • Min: @FormatChips(room.MinBet)
                                            </div>
                                            <div class="table-meta">
                                                Code: @room.Code @if (room.IsClosing) { <span>• Closing after the current round</span> }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="table-right" style="gap: 0.5rem;">
                                        <div class="table-players">
                                            @room.CurrentPlayers/@room.MaxPlayers
                                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="14" height="14">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                                            </svg>
                                        </div>
                                        @if (room.IsClosing)
                                        {
                                            <span class="table-status full">Closing</span>
                                        }
                                        else if (isHost)
                                        {
                                            <button class="btn-join" @onclick="() => EnterOwnedRoomAsync(room)">Return</button>
                                            <button class="btn-play" style="width:auto;" @onclick="() => DeleteTableAsync(room)">Delete</button>
                                        }
                                        else
                                        {
                                            <button class="btn-join" @onclick="() => JoinTableAsync(room)">Join</button>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </section>

                <section class="leaderboard">
                    <h2 class="section-header">
                        <span>🏆 Top Chads</span>
                    </h2>
                    <div class="leaderboard-list">
                        @if (leaderboardEntries.Count == 0)
                        {
                            <div class="leader-item">
                                <div class="leader-rank rank-1">-</div>
                                <div class="leader-avatar">C</div>
                                <div class="leader-info">
                                    <div class="leader-name">No Ranked Players Yet</div>
                                    <div class="leader-chips">Registered players will appear here once their wallet balance is available.</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            @foreach (var player in VisibleLeaderboardEntries)
                            {
                                var isCurrentUser = player.UserId == currentUserId;
                                var decoration = GetLeaderboardDecoration(player.Rank);
                                <div class="leader-item @(isCurrentUser ? "leader-current" : "") @(player.Rank <= 5 ? $"leader-top-{player.Rank}" : string.Empty)">
                                    <div class="leader-rank rank-@(Math.Min(player.Rank, 3))">@player.Rank</div>
                                    <div class="leader-avatar">@player.UserName[0]</div>
                                    <div class="leader-info">
                                        <div class="leader-name">@player.UserName @(isCurrentUser ? "(You)" : "")</div>
                                        <div class="leader-chips">@FormatChips(player.Chips)</div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(decoration))
                                    {
                                        <div class="leader-medal">@decoration</div>
                                    }
                                </div>
                            }

                            @if (leaderboardEntries.Count > 5)
                            {
                                <button class="leaderboard-toggle" @onclick="ToggleLeaderboardExpanded">
                                    @(showFullLeaderboard ? "Show Top 5" : $"Show All Players ({leaderboardEntries.Count})")
                                </button>
                            }
                        }
                    </div>
                </section>
            </div>

            <div class="two-column-section" style="margin-top: 2rem;">
                <section class="live-tables">
                    <h2 class="section-header">
                        <span>🤝 Friends & Requests</span>
                    </h2>

                    <div class="tables-list">
                        <div class="table-item">
                            <div class="table-left" style="width: 100%;">
                                <div class="table-info" style="width: 100%;">
                                    <div class="table-name">Add Friend By Code</div>
                                    <div class="table-meta">Send a request that can be accepted or ignored from the dashboard.</div>
                                    <div style="display:flex; gap:0.75rem; margin-top:0.75rem;">
                                        <input @bind="friendCodeInput" class="form-control" placeholder="C2C-123456-654321" />
                                        <button class="btn-join" @onclick="SendFriendRequestAsync">Send Request</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (dashboard.PendingRequests.Count > 0)
                        {
                            @foreach (var request in dashboard.PendingRequests)
                            {
                                <div class="table-item">
                                    <div class="table-left">
                                        <div class="table-info">
                                            <div class="table-name">@request.RequesterName</div>
                                            <div class="table-meta">@request.RequesterFriendCode sent a friend request</div>
                                        </div>
                                    </div>
                                    <div class="table-right" style="gap:0.5rem;">
                                        <button class="btn-join" @onclick="() => RespondToFriendRequestAsync(request.RequestId, true)">Accept</button>
                                        <button class="btn-play" style="width:auto;" @onclick="() => RespondToFriendRequestAsync(request.RequestId, false)">Ignore</button>
                                    </div>
                                </div>
                            }
                        }

                        @if (dashboard.Friends.Count == 0)
                        {
                            <div class="table-item">
                                <div class="table-left">
                                    <div class="table-info">
                                        <div class="table-name">No Friends Added Yet</div>
                                        <div class="table-meta">Your friends list and their table activity will show up here.</div>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            @foreach (var friend in dashboard.Friends)
                            {
                                <div class="table-item">
                                    <div class="table-left">
                                        <div class="table-icon">@friend.Name[0]</div>
                                        <div class="table-info">
                                            <div class="table-name">@friend.Name</div>
                                            <div class="table-meta">
                                                @friend.FriendCode • @friend.Status
                                                @if (friend.ActiveRoomName is not null)
                                                {
                                                    <span>• @friend.ActiveRoomName (@friend.ActiveGame)</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="table-right">
                                        @if (friend.CanJoinActiveRoom && friend.ActiveRoomId.HasValue)
                                        {
                                            <button class="btn-join" @onclick="() => JoinRoomAsync(friend.ActiveRoomId.Value, friend.ActiveGame)">Join Friend</button>
                                        }
                                        else
                                        {
                                            <span class="table-status @(friend.Status == FriendStatus.Offline ? "full" : "")">@friend.Status</span>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </section>

                <section class="leaderboard">
                    <h2 class="section-header">
                        <span>📌 Friends Tables</span>
                    </h2>
                    <div class="tables-list">
                        @if (!dashboard.JoinableRooms.Any(room => room.HostUserId != currentUserId))
                        {
                            <div class="table-item">
                                <div class="table-left">
                                    <div class="table-info">
                                        <div class="table-name">No Friend Tables Available</div>
                                        <div class="table-meta">Public tables from your friends will show up here when they go live.</div>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            @foreach (var room in dashboard.JoinableRooms.Where(room => room.HostUserId != currentUserId))
                            {
                                <div class="table-item">
                                    <div class="table-left">
                                        <div class="table-icon">@(room.Game == GameType.Blackjack ? "🂡" : "🃏")</div>
                                        <div class="table-info">
                                            <div class="table-name">@room.Name</div>
                                            <div class="table-meta">@room.Game • Code: @room.Code • Min: @FormatChips(room.MinBet)</div>
                                        </div>
                                    </div>
                                    <div class="table-right">
                                        <button class="btn-join" @onclick="() => JoinTableAsync(room)">Join</button>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </section>
            </div>
        </div>
    }
</div>

@code {
    private DashboardViewModel? dashboard;
    private Guid currentUserId;
    private string friendCodeInput = string.Empty;
    private string? statusMessage;
    private bool statusIsError;
    private bool showUserMenu;
    private PeriodicTimer? heartbeatTimer;
    private CancellationTokenSource? heartbeatCts;
    private IReadOnlyList<LeaderboardEntryViewModel> leaderboardEntries = Array.Empty<LeaderboardEntryViewModel>();
    private bool showFullLeaderboard;
    private PlayerStatisticsDto? playerStats;

    private int rankProgress;
    private int winRate;
    private int winStreak;
    private int bestStreak;
    private int blackjackOnline;
    private int blackjackTables;
    private int pokerOnline;
    private int pokerTables;
    private IEnumerable<LeaderboardEntryViewModel> VisibleLeaderboardEntries =>
        showFullLeaderboard ? leaderboardEntries : leaderboardEntries.Take(5);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdClaim = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!Guid.TryParse(userIdClaim, out currentUserId))
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        await RefreshAsync();
        heartbeatCts = new CancellationTokenSource();
        heartbeatTimer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        _ = RunHeartbeatAsync(heartbeatCts.Token);
    }

    private async Task RunHeartbeatAsync(CancellationToken token)
    {
        if (heartbeatTimer is null)
        {
            return;
        }

        while (!token.IsCancellationRequested && await heartbeatTimer.WaitForNextTickAsync(token))
        {
            await MultiplayerService.SetPresenceAsync(currentUserId, UserPresenceStatus.Online);
            await RefreshAsync(false);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RefreshAsync(bool setPresence = true)
    {
        if (setPresence)
        {
            await MultiplayerService.SetPresenceAsync(currentUserId, UserPresenceStatus.Online);
        }

        dashboard = await MultiplayerService.GetDashboardAsync(currentUserId);
        leaderboardEntries = await LeaderboardService.GetLeaderboardAsync();
        if (dashboard is null)
        {
            return;
        }

        playerStats = await PlayerStatisticsService.GetPlayerStatisticsAsync(currentUserId);
        rankProgress = GetRankProgress(dashboard.Chips);
        winRate = playerStats.TotalGamesPlayed == 0 ? 0 : (int)Math.Round((double)playerStats.TotalWins / playerStats.TotalGamesPlayed * 100);
        winStreak = playerStats.CurrentWinStreak;
        bestStreak = playerStats.BestWinStreak;

        blackjackTables = dashboard.JoinableRooms.Count(room => room.Game == GameType.Blackjack && !room.IsClosing);
        pokerTables = dashboard.JoinableRooms.Count(room => room.Game == GameType.Poker && !room.IsClosing);

        blackjackOnline = dashboard.Friends.Count(friend =>
            friend.Status != FriendStatus.Offline &&
            friend.ActiveGame == GameType.Blackjack) + 1;
        pokerOnline = dashboard.Friends.Count(friend =>
            friend.Status != FriendStatus.Offline &&
            friend.ActiveGame == GameType.Poker) + 1;
    }

    private async Task SendFriendRequestAsync()
    {
        var result = await MultiplayerService.SendFriendRequestAsync(currentUserId, friendCodeInput);
        SetStatus(result.Message, !result.Ok);
        if (result.Ok)
        {
            friendCodeInput = string.Empty;
            await RefreshAsync();
        }
    }

    private async Task RespondToFriendRequestAsync(Guid requestId, bool accept)
    {
        var result = await MultiplayerService.RespondToFriendRequestAsync(currentUserId, requestId, accept);
        SetStatus(result.Message, !result.Ok);
        await RefreshAsync();
    }

    private async Task JoinTableAsync(RoomSummaryViewModel room)
    {
        var result = await MultiplayerService.JoinRoomAsync(currentUserId, room.RoomId);
        SetStatus(result.Message, !result.Ok);
        if (!result.Ok)
        {
            await RefreshAsync();
            return;
        }

        NavigateToGame(room.RoomId, room.Game);
    }

    private Task EnterOwnedRoomAsync(RoomSummaryViewModel room)
    {
        NavigateToGame(room.RoomId, room.Game);
        return Task.CompletedTask;
    }

    private async Task DeleteTableAsync(RoomSummaryViewModel room)
    {
        var result = await MultiplayerService.RequestRoomDeletionAsync(currentUserId, room.RoomId);
        SetStatus(result.Message, !result.Ok);
        await RefreshAsync();
    }

    private async Task JoinRoomAsync(Guid roomId, GameType? game)
    {
        if (game is null)
        {
            return;
        }

        var result = await MultiplayerService.JoinRoomAsync(currentUserId, roomId);
        SetStatus(result.Message, !result.Ok);
        if (result.Ok)
        {
            NavigateToGame(roomId, game.Value);
        }
        else
        {
            await RefreshAsync();
        }
    }

    private void JoinGame(string gameType)
    {
        NavigationManager.NavigateTo(gameType == "blackjack" ? "/BlackjackLobby" : "/PokerLobby");
    }

    private void ToggleUserMenu() => showUserMenu = !showUserMenu;

    private void ViewProfile()
    {
        showUserMenu = false;
        NavigationManager.NavigateTo("/profile");
    }

    private void ViewStats()
    {
        showUserMenu = false;
        NavigationManager.NavigateTo("/player-stats");
    }

    private async Task HandleLogout()
    {
        showUserMenu = false;

        try
        {
            var result = await JS.InvokeAsync<ApiResult>("auth.logout");
            if (result.Ok)
            {
                NavigationManager.NavigateTo("/", forceLoad: true);
            }
            else
            {
                SetStatus(result.Status == 0 ? $"Logout failed: {result.Text}" : $"Logout failed with status {result.Status}.", true);
            }
        }
        catch (Exception ex)
        {
            SetStatus($"Logout error: {ex.Message}", true);
        }
    }

    private void NavigateToGame(Guid roomId, GameType game)
    {
        NavigationManager.NavigateTo(game == GameType.Blackjack
            ? $"/blackjack-game/{roomId}"
            : $"/poker-game/{roomId}");
    }

    private void SetStatus(string message, bool isError)
    {
        statusMessage = message;
        statusIsError = isError;
    }

    private void ToggleLeaderboardExpanded() => showFullLeaderboard = !showFullLeaderboard;

    private static int GetRankProgress(long chips)
    {
        if (chips < 5_000)
        {
            return (int)Math.Clamp(Math.Round(chips / 5_000d * 100), 0, 100);
        }

        if (chips < 10_000)
        {
            return (int)Math.Clamp(Math.Round((chips - 5_000) / 5_000d * 100), 0, 100);
        }

        return 100;
    }

    private static string FormatChips(long chips)
    {
        if (chips >= 1_000_000) return $"${chips / 1_000_000.0:F1}M";
        if (chips >= 1_000) return $"${chips / 1_000.0:F1}K";
        return $"${chips}";
    }

    private static string GetMedal(int position) => position switch
    {
        0 => "🥇",
        1 => "🥈",
        2 => "🥉",
        _ => string.Empty
    };

    private static string GetLeaderboardDecoration(int rank) => rank switch
    {
        1 => "👑",
        2 => "🥈",
        3 => "🥉",
        4 => "💎",
        5 => "🔥",
        _ => string.Empty
    };

    private static string SignedChips(long chips) => chips >= 0 ? $"+{FormatChips(chips)}" : $"-{FormatChips(Math.Abs(chips))}";
    private int DisplayTotalWins => playerStats?.TotalWins ?? dashboard?.TotalWins ?? 0;
    private int DisplayTotalGames => playerStats?.TotalGamesPlayed ?? dashboard?.TotalGames ?? 0;

    public ValueTask DisposeAsync()
    {
        heartbeatCts?.Cancel();
        heartbeatTimer?.Dispose();
        heartbeatCts?.Dispose();
        return ValueTask.CompletedTask;
    }

    private sealed class ApiResult
    {
        public bool Ok { get; set; }
        public int Status { get; set; }
        public string Text { get; set; } = string.Empty;
    }
}
