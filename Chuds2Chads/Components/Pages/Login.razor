@page "/login"
@rendermode InteractiveServer
@using System.Net
@using System.Text.Json
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Login - Chuds to Chads Casino</PageTitle>

<div class="auth-container">

    <!-- Animated background cards -->
    <div class="bg-elements">
        <div class="bg-card bg-card-1">♠</div>
        <div class="bg-card bg-card-2">♥</div>
        <div class="bg-card bg-card-3">♦</div>
        <div class="bg-card bg-card-4">♣</div>
    </div>

    <!-- Left panel: branding -->
    <div class="auth-panel auth-brand">
        <div class="brand-inner">
            <NavLink href="/" class="logo-link">
                <img src="/images/C2C-Logo-Transparent.png" alt="C2C Casino" class="logo-image" />
            </NavLink>
            <div class="brand-tagline">
                <h2>Welcome Back, <span class="highlight">Chad.</span></h2>
                <p>Your chips are waiting. The table's hot. Let's get back in the game.</p>
            </div>
            <div class="brand-chips">
                <div class="mini-chip chip-green">♠</div>
                <div class="mini-chip chip-gold">♥</div>
                <div class="mini-chip chip-red">♦</div>
            </div>
            <div class="brand-stat-row">
                <div class="brand-stat">
                    <span class="brand-stat-value">430+</span>
                    <span class="brand-stat-label">Online Now</span>
                </div>
                <div class="brand-stat">
                    <span class="brand-stat-value">12</span>
                    <span class="brand-stat-label">Live Tables</span>
                </div>
                <div class="brand-stat">
                    <span class="brand-stat-value">Free</span>
                    <span class="brand-stat-label">To Play</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Right panel: login form -->
    <div class="auth-panel auth-form-panel">
        <div class="auth-form-inner">
            <div class="form-header">
                <h1 class="form-title">Sign In</h1>
                <p class="form-subtitle">Enter the casino floor</p>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-error">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    @errorMessage
                </div>
            }

            <div class="form-group">
                <label class="form-label">Username</label>
                <div class="input-wrapper">
                    <svg class="input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                    <input class="form-input"
                           type="text"
                           placeholder="Enter your username"
                           @bind="username"
                           @bind:event="oninput"
                           @onkeydown="HandleKeyDown" />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Password</label>
                <div class="input-wrapper">
                    <svg class="input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                    </svg>
                    <input class="form-input"
                           type="@(showPassword ? "text" : "password")"
                           placeholder="Enter your password"
                           @bind="password"
                           @bind:event="oninput"
                           @onkeydown="HandleKeyDown" />
                    <button class="toggle-password" @onclick="TogglePassword" type="button">
                        @if (showPassword)
                        {
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>
                            </svg>
                        }
                        else
                        {
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                            </svg>
                        }
                    </button>
                </div>
            </div>

            <button class="btn-submit @(isLoading ? "loading" : "")" @onclick="HandleLogin" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner"></span>
                    <span>Entering Casino...</span>
                }
                else
                {
                    <span>Enter the Casino</span>
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                    </svg>
                }
            </button>

            <div class="form-divider">
                <span>New around here?</span>
            </div>

            <button class="btn-secondary-link" @onclick='() => Navigation.NavigateTo("/register")'>
                Create an Account
            </button>
            <p class="form-footer">
                By signing in, you agree that all currency is virtual and for entertainment only.
            </p>
        </div>
    </div>
</div>

@code {
    private string username = string.Empty;
    private string password = string.Empty;
    private string errorMessage = string.Empty;
    private bool isLoading = false;
    private bool showPassword = false;

    private sealed class LoginResult
    {
        public bool Ok { get; set; }
        public int Status { get; set; }
        public string? Text { get; set; }
    }

    private void TogglePassword() => showPassword = !showPassword;

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await HandleLogin();
    }

    private async Task HandleLogin()
    {
        errorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Please enter your username and password.";
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            var result = await JS.InvokeAsync<LoginResult>("auth.login", username, password);

            if (result.Ok)
            {
                // Short delay to ensure cookie is set in the browser
                await Task.Delay(200);

                var isAdmin = false;
                if (!string.IsNullOrEmpty(result.Text))
                {
                    try
                    {
                        var data = JsonSerializer.Deserialize<JsonElement>(result.Text);
                        if (data.TryGetProperty("isAdmin", out var adminProp))
                            isAdmin = adminProp.GetBoolean();
                    }
                    catch { }
                }

                Navigation.NavigateTo(isAdmin ? "/admin" : "/", forceLoad: true);
            }
            else
            {
                if (!string.IsNullOrEmpty(result.Text))
                {
                    errorMessage = $"Login failed: {result.Text}";
                }
                else if (result.Status == (int)HttpStatusCode.Unauthorized)
                {
                    errorMessage = "Invalid username or password.";
                }
                else
                {
                    errorMessage = $"Login failed with status {result.Status}.";
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
